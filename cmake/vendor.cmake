function(lnd_vendor_quiet TARGET)
    if(CMAKE_C_COMPILER_ID MATCHES "Clang|GNU")
        target_compile_options(${TARGET} PRIVATE -w)
    endif()
endfunction()

function(lnd_vendor_soundtouch)
    if(TARGET lnd_soundtouch)
        return()
    endif()
    set(dir ${LND_VENDOR_DIR}/soundtouch)
    set(sources AAFilter.cpp cpu_detect_x86.cpp FIFOSampleBuffer.cpp FIRFilter.cpp InterpolateCubic.cpp
        InterpolateLinear.cpp InterpolateShannon.cpp RateTransposer.cpp SoundTouch.cpp sse_optimized.cpp TDStretch.cpp)
    include(${CMAKE_CURRENT_SOURCE_DIR}/modules/processing/stretch/soundtouch/vendor_safety.cmake)
    add_library(lnd_soundtouch STATIC ${patched_sources})
    target_include_directories(lnd_soundtouch PRIVATE ${dir}/include ${dir}/source/SoundTouch)
    target_compile_definitions(lnd_soundtouch PRIVATE SOUNDTOUCH_FLOAT_SAMPLES=1)
    set_target_properties(lnd_soundtouch PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS OFF POSITION_INDEPENDENT_CODE ON CXX_VISIBILITY_PRESET hidden)
    if(MSVC)
        target_compile_options(lnd_soundtouch PRIVATE /EHsc /O2)
    else()
        target_compile_options(lnd_soundtouch PRIVATE -fexceptions -ffunction-sections -fdata-sections
            $<$<CONFIG:Release>:-O3> -fno-math-errno -fno-trapping-math)
    endif()
    option(LND_SOUNDTOUCH_SIMD "Enable vendor SoundTouch SIMD kernels" ON)
    if(LND_SOUNDTOUCH_SIMD)
        include(CheckCXXSourceCompiles)
        check_cxx_source_compiles("#if !defined(__aarch64__) && !defined(_M_ARM64) && !defined(__ARM_NEON)\n#error no_neon\n#endif\nint main() { return 0; }" LND_SOUNDTOUCH_NEON)
        if(LND_SOUNDTOUCH_NEON)
            target_compile_definitions(lnd_soundtouch PRIVATE SOUNDTOUCH_USE_NEON=1)
        endif()
    else()
        target_compile_definitions(lnd_soundtouch PRIVATE SOUNDTOUCH_DISABLE_X86_OPTIMIZATIONS=1)
    endif()
    lnd_vendor_quiet(lnd_soundtouch)
endfunction()

function(lnd_vendor_ogg)
    if(TARGET lnd_ogg)
        return()
    endif()
    set(dir ${LND_VENDOR_DIR}/ogg)
    set(gen ${LND_GENERATED_DIR}/ogg/ogg)
    file(MAKE_DIRECTORY ${gen})
    file(WRITE ${gen}/config_types.h.tmp "#pragma once\n#include <stdint.h>\ntypedef int16_t ogg_int16_t;\ntypedef uint16_t ogg_uint16_t;\ntypedef int32_t ogg_int32_t;\ntypedef uint32_t ogg_uint32_t;\ntypedef int64_t ogg_int64_t;\ntypedef uint64_t ogg_uint64_t;\n")
    execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${gen}/config_types.h.tmp ${gen}/config_types.h)
    file(REMOVE ${gen}/config_types.h.tmp)
    add_library(lnd_ogg STATIC ${dir}/src/framing.c ${dir}/src/bitwise.c)
    target_include_directories(lnd_ogg PUBLIC ${dir}/include ${LND_GENERATED_DIR}/ogg)
    lnd_vendor_quiet(lnd_ogg)
endfunction()

