    target_link_libraries(lnd_vorbis PUBLIC lnd_ogg)
    add_library(lnd_vorbisfile STATIC ${dir}/lib/vorbisfile.c)
    target_include_directories(lnd_vorbisfile PUBLIC ${dir}/include PRIVATE ${dir}/lib)
    target_link_libraries(lnd_vorbisfile PUBLIC lnd_vorbis)
