function(lnd_vendor_opus)
    if(TARGET opus)
        return()
    endif()
    if(LND_MINIMAL)
        option(OPUS_FIXED_POINT "Use integer Opus kernels" ON)
        if(LND_MODULE_OPUS_ENCODER)
            set(LND_OPUS_FLOAT_DEFAULT ON)
        else()
            set(LND_OPUS_FLOAT_DEFAULT OFF)
        endif()
        option(OPUS_ENABLE_FLOAT_API "Enable Opus float API" ${LND_OPUS_FLOAT_DEFAULT})
        if(LND_MODULE_OPUS_ENCODER AND NOT OPUS_ENABLE_FLOAT_API)
            message(FATAL_ERROR "The Opus encoder requires OPUS_ENABLE_FLOAT_API=ON; disable LND_MODULE_OPUS_ENCODER for integer decoding")
        endif()
        option(OPUS_DISABLE_INTRINSICS "Disable Opus platform intrinsics" ON)
        if(NOT LND_OS_MODE)
            option(OPUS_STACK_PROTECTOR "Require a target stack protector runtime" OFF)
            option(OPUS_HARDENING "Enable Opus assertions and diagnostic runtime" OFF)
            option(OPUS_FORTIFY_SOURCE "Require fortified libc functions" OFF)
        endif()
    endif()
    set(OPUS_BUILD_SHARED_LIBRARY OFF CACHE BOOL "" FORCE)
    set(OPUS_BUILD_TESTING OFF CACHE BOOL "" FORCE)
    set(OPUS_BUILD_PROGRAMS OFF CACHE BOOL "" FORCE)
    set(OPUS_INSTALL_PKG_CONFIG_MODULE OFF CACHE BOOL "" FORCE)
    set(OPUS_INSTALL_CMAKE_CONFIG_MODULE OFF CACHE BOOL "" FORCE)
    add_subdirectory(${LND_VENDOR_DIR}/opus ${CMAKE_BINARY_DIR}/vendor/opus EXCLUDE_FROM_ALL)
    lnd_vendor_quiet(opus)
    if(LND_MINIMAL AND CMAKE_C_COMPILER_ID MATCHES "Clang|GNU")
        target_compile_options(opus PRIVATE -ffunction-sections -fdata-sections)
    endif()
endfunction()

function(lnd_vendor_opusfile)
    lnd_vendor_ogg()
    lnd_vendor_opus()
    if(TARGET lnd_opusfile)
        return()
    endif()
    set(dir ${LND_VENDOR_DIR}/opusfile)
    set(source ${dir}/src/opusfile.c)
    if(NOT LND_OS_MODE)
        include(${CMAKE_CURRENT_SOURCE_DIR}/modules/formats/opus/vendor.cmake)
    endif()
    add_library(lnd_opusfile STATIC ${source} ${dir}/src/info.c ${dir}/src/internal.c)
    if(LND_OS_MODE)
        target_sources(lnd_opusfile PRIVATE ${dir}/src/stream.c)
    else()
        target_compile_definitions(lnd_opusfile PRIVATE OP_DISABLE_STREAMS)
    endif()
    if(OPUS_FIXED_POINT)
        target_compile_definitions(lnd_opusfile PRIVATE OP_FIXED_POINT)
    endif()
    if(NOT OPUS_ENABLE_FLOAT_API)
        target_compile_definitions(lnd_opusfile PRIVATE OP_DISABLE_FLOAT_API)
    endif()
    if(LND_MINIMAL AND CMAKE_C_COMPILER_ID MATCHES "Clang|GNU")
        target_compile_options(lnd_opusfile PRIVATE -ffunction-sections -fdata-sections)
        target_compile_options(lnd_ogg PRIVATE -ffunction-sections -fdata-sections)
    endif()
    target_include_directories(lnd_opusfile PUBLIC ${dir}/include PRIVATE ${dir}/src)
    target_compile_definitions(lnd_opusfile PRIVATE OP_DISABLE_HTTP)
    target_link_libraries(lnd_opusfile PUBLIC opus lnd_ogg)
    lnd_vendor_quiet(lnd_opusfile)
endfunction()

