function(lnd_vendor_lame)
    if(TARGET lnd_lame)
        return()
    endif()
    set(dir ${LND_VENDOR_DIR}/lame)
    set(gen ${LND_GENERATED_DIR}/lame)
    file(MAKE_DIRECTORY ${gen})
    include(CheckTypeSize)
    check_type_size(long LND_LAME_LONG)
    set(cfg "#pragma once\n#include <stdint.h>\n#define STDC_HEADERS 1\n#define HAVE_STDINT_H 1\n#define HAVE_INTTYPES_H 1\n#define HAVE_STDLIB_H 1\n#define HAVE_STRING_H 1\n#define HAVE_ERRNO_H 1\n#define HAVE_FCNTL_H 1\n#define HAVE_LIMITS_H 1\n#define HAVE_STRCHR 1\n#define HAVE_MEMCPY 1\n")
    string(APPEND cfg "#define SIZEOF_SHORT 2\n#define SIZEOF_INT 4\n#define SIZEOF_LONG ${LND_LAME_LONG}\n#define SIZEOF_LONG_LONG 8\n#define SIZEOF_FLOAT 4\n#define SIZEOF_DOUBLE 8\n#define SIZEOF_UNSIGNED_SHORT 2\n#define SIZEOF_UNSIGNED_INT 4\n#define SIZEOF_UNSIGNED_LONG ${LND_LAME_LONG}\n#define SIZEOF_UNSIGNED_LONG_LONG 8\n")
    file(STRINGS ${dir}/configure.ac version REGEX "^AC_INIT")
    string(REGEX MATCH "[0-9]+[.][0-9]+([.][0-9]+)?" version "${version}")
    string(APPEND cfg "#define HAVE_IEEE754_FLOAT32_T 1\n#define HAVE_IEEE754_FLOAT64_T 1\ntypedef float ieee754_float32_t;\ntypedef double ieee754_float64_t;\ntypedef long double ieee854_float80_t;\n#define PACKAGE \"lame\"\n#define VERSION \"${version}\"\n#define LAME_LIBRARY_BUILD 1\n#define USE_FAST_LOG 1\n")
    file(WRITE ${gen}/config.h.tmp "${cfg}")
    execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${gen}/config.h.tmp ${gen}/config.h)
    file(REMOVE ${gen}/config.h.tmp)
    set(sources VbrTag.c bitstream.c encoder.c fft.c gain_analysis.c id3tag.c lame.c newmdct.c presets.c psymodel.c quantize.c quantize_pvt.c reservoir.c set_get.c tables.c takehiro.c util.c vbrquantize.c version.c)
    list(TRANSFORM sources PREPEND ${dir}/libmp3lame/)
    add_library(lnd_lame STATIC ${sources})
    target_include_directories(lnd_lame PUBLIC ${dir}/include PRIVATE ${gen} ${dir}/libmp3lame ${dir}/mpglib)
    target_compile_definitions(lnd_lame PRIVATE HAVE_CONFIG_H)
    set_target_properties(lnd_lame PROPERTIES C_STANDARD 11 C_EXTENSIONS ON)
    lnd_vendor_quiet(lnd_lame)
endfunction()

function(lnd_vendor_ffmpeg)
    if(TARGET lnd_ffmpeg)
        return()
    endif()
    include(ExternalProject)
    include(ProcessorCount)
    set(src ${LND_VENDOR_DIR}/ffmpeg)
    set(build ${CMAKE_BINARY_DIR}/vendor/ffmpeg)
    get_filename_component(compiler_dir ${CMAKE_C_COMPILER} DIRECTORY)
    if(WIN32)
        set(msys_bin ${compiler_dir}/../../usr/bin C:/msys64/usr/bin)
        find_program(LND_SH NAMES sh PATHS ${msys_bin} NO_DEFAULT_PATH)
        find_program(LND_MAKE NAMES make PATHS ${msys_bin} NO_DEFAULT_PATH)
    else()
        find_program(LND_SH NAMES sh)
        find_program(LND_MAKE NAMES gmake make)
    endif()
    if(NOT LND_SH OR NOT LND_MAKE)
        message(FATAL_ERROR "LND_MODULE_FFMPEG needs sh and make to run FFmpeg's configure (MSYS2: pacman -S make)")
    endif()
    ProcessorCount(jobs)
    if(jobs EQUAL 0)
        set(jobs 4)
    endif()
    execute_process(COMMAND ${CMAKE_C_COMPILER} -dumpmachine OUTPUT_VARIABLE triple OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE triple_rc)
    if(triple_rc EQUAL 0 AND triple MATCHES "^([A-Za-z0-9_]+)-")
        string(TOLOWER "${CMAKE_MATCH_1}" arch)
    else()
        string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" arch)
    endif()
    if(arch MATCHES "arm64|aarch64")
        set(arch aarch64)
    elseif(arch MATCHES "amd64|x86_64")
        set(arch x86_64)
    elseif(arch MATCHES "^(x86|i[3-6]86)$")
        set(arch x86)
    endif()
    set(flags --arch=${arch} --enable-static --disable-shared --disable-programs --disable-doc --disable-avdevice --disable-avfilter --disable-swscale --disable-network --disable-autodetect --disable-encoders --disable-protocols --disable-devices --disable-filters --disable-hwaccels --disable-bsfs --disable-decoders --disable-debug)
    if(WIN32)
        list(APPEND flags --target-os=mingw64)
    endif()
    find_program(LND_NASM NAMES nasm)
    if(NOT LND_NASM)
        list(APPEND flags --disable-x86asm)
    endif()
    file(STRINGS ${CMAKE_CURRENT_SOURCE_DIR}/modules/formats/ffmpeg/decoders.txt default_decoders)
    set(LND_FFMPEG_DECODERS "${default_decoders}" CACHE STRING "FFmpeg decoders compiled into the ffmpeg module")
    set(LND_FFMPEG_FLAGS "" CACHE STRING "Extra flags for FFmpeg's configure")
    foreach(decoder ${LND_FFMPEG_DECODERS})
        list(APPEND flags --enable-decoder=${decoder})
    endforeach()
    file(STRINGS ${CMAKE_CURRENT_SOURCE_DIR}/modules/formats/ffmpeg/encoders.txt default_encoders)
    set(LND_FFMPEG_ENCODERS "${default_encoders}" CACHE STRING "FFmpeg encoders compiled into the ffmpeg module")
    foreach(encoder ${LND_FFMPEG_ENCODERS})
        list(APPEND flags --enable-encoder=${encoder})
    endforeach()
    list(APPEND flags ${LND_FFMPEG_FLAGS})
    list(JOIN flags " " LND_FF_FLAGS)
    set(LND_FF_SRC ${src})
    set(LND_FF_BUILD ${build})
    set(LND_FF_CC ${CMAKE_C_COMPILER})
    set(LND_FF_MAKE ${LND_MAKE})
    set(LND_FF_JOBS ${jobs})
    configure_file(${CMAKE_CURRENT_SOURCE_DIR}/modules/formats/ffmpeg/build.sh.in ${build}/build.sh @ONLY)
    configure_file(${src}/RELEASE ${build}/source-release COPYONLY)
    set(libs "")
    foreach(lib avformat avcodec swresample avutil)
        list(APPEND libs ${build}/lib${lib}/lib${lib}.a)
    endforeach()
    ExternalProject_Add(lnd_ffmpeg_build
        PREFIX ${build}/ep
        SOURCE_DIR ${src}
        BINARY_DIR ${build}
        CONFIGURE_COMMAND ${LND_SH} ${build}/build.sh configure
        BUILD_COMMAND ${LND_SH} ${build}/build.sh build
        INSTALL_COMMAND ""
        BUILD_BYPRODUCTS ${libs}
        LOG_CONFIGURE ON
        LOG_BUILD ON
        LOG_OUTPUT_ON_FAILURE ON)
    ExternalProject_Add_StepDependencies(lnd_ffmpeg_build configure ${build}/build.sh ${build}/source-release)
    add_library(lnd_ffmpeg INTERFACE)
    add_dependencies(lnd_ffmpeg lnd_ffmpeg_build)
    target_include_directories(lnd_ffmpeg INTERFACE ${src} ${build})
    target_link_libraries(lnd_ffmpeg INTERFACE ${libs})
    if(WIN32)
        target_link_libraries(lnd_ffmpeg INTERFACE bcrypt ole32 user32)
    elseif(UNIX)
        target_link_libraries(lnd_ffmpeg INTERFACE m pthread)
    endif()
endfunction()
