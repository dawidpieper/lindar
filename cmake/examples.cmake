function(lnd_example category name)
    if(category MATCHES "^os" AND (NOT LND_OS_MODE OR NOT LND_USE_LIBC_ALLOC))
        return()
    endif()
    foreach(requirement IN LISTS ARGN)
        if(NOT ${requirement})
            return()
        endif()
    endforeach()
    add_executable(${name} examples/${category}/${name}/main.c)
    set_target_properties(${name} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/examples")
    target_link_libraries(${name} PRIVATE lindar)
    if(UNIX)
        target_link_libraries(${name} PRIVATE m)
    endif()
    if(CMAKE_C_COMPILER_ID MATCHES "Clang|GNU")
        target_compile_options(${name} PRIVATE -Wall -Wextra)
    endif()
    set_property(GLOBAL APPEND PROPERTY LND_EXAMPLE_TARGETS ${name})
endfunction()

