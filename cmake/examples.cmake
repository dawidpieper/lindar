get_property(examples GLOBAL PROPERTY LND_EXAMPLE_TARGETS)
if(WIN32 AND LND_SHARED)
    set(runtime "${CMAKE_CURRENT_BINARY_DIR}/examples")
    if(CMAKE_CONFIGURATION_TYPES)
        string(APPEND runtime "/$<CONFIG>")
    endif()
    add_custom_target(lindar_example_runtime ALL
        COMMAND ${CMAKE_COMMAND} -E make_directory "${runtime}"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different $<TARGET_FILE:lindar> "${runtime}"
        DEPENDS lindar
        VERBATIM)
    foreach(name IN LISTS examples)
        add_dependencies(${name} lindar_example_runtime)
    endforeach()
endif()
set(example_paths "")
foreach(name IN LISTS examples)
    string(APPEND example_paths "$<TARGET_FILE:${name}>\n")
endforeach()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/examples-$<CONFIG>.txt" CONTENT "${example_paths}")
