if(NOT TARGET lnd_openssl_crypto OR NOT TARGET lnd_openssl_ssl)
    message(FATAL_ERROR "Lindar vendored OpenSSL targets have not been created")
endif()
foreach(component Crypto SSL)
    string(TOLOWER ${component} lower)
    if(TARGET OpenSSL::${component})
        get_target_property(actual OpenSSL::${component} ALIASED_TARGET)
        if(NOT actual STREQUAL "lnd_openssl_${lower}")
            message(FATAL_ERROR "OpenSSL::${component} already refers to another build; Lindar HTTP requires its vendored OpenSSL")
        endif()
    else()
        add_library(OpenSSL::${component} ALIAS lnd_openssl_${lower})
    endif()
endforeach()
set(OPENSSL_FOUND TRUE)
set(OpenSSL_FOUND TRUE)
file(STRINGS "${LND_VENDOR_DIR}/openssl/VERSION.dat" version_parts REGEX "^(MAJOR|MINOR|PATCH)=")
list(TRANSFORM version_parts REPLACE "^[A-Z]+=" "")
list(JOIN version_parts "." OPENSSL_VERSION)
set(OPENSSL_INCLUDE_DIR "${LND_OPENSSL_BUILD}/include;${LND_VENDOR_DIR}/openssl/include")
set(OPENSSL_LIBRARIES lnd_openssl_ssl lnd_openssl_crypto)
set(OPENSSL_CRYPTO_LIBRARY lnd_openssl_crypto)
set(OPENSSL_SSL_LIBRARY lnd_openssl_ssl)
