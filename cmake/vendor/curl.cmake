function(lnd_vendor_curl)
    if(TARGET lnd_curl)
        return()
    endif()
    cmake_policy(PUSH)
    cmake_policy(SET CMP0077 NEW)
    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
    set(BUILD_SHARED_LIBS OFF)
    set(BUILD_STATIC_LIBS ON)
    set(BUILD_CURL_EXE OFF)
    set(BUILD_TESTING OFF)
    set(BUILD_LIBCURL_DOCS OFF)
    set(BUILD_MISC_DOCS OFF)
    set(ENABLE_CURL_MANUAL OFF)
    set(CURL_DISABLE_INSTALL ON)
    set(CURL_ENABLE_EXPORT_TARGET OFF)
    set(CURL_USE_PKGCONFIG OFF)
    set(CURL_USE_CMAKECONFIG OFF)
    set(CURL_ZLIB OFF CACHE STRING "" FORCE)
    set(CURL_BROTLI OFF CACHE STRING "" FORCE)
    set(CURL_ZSTD OFF CACHE STRING "" FORCE)
    set(CURL_USE_LIBPSL OFF)
    set(USE_LIBIDN2 OFF)
    set(USE_NGHTTP2 OFF)
    set(USE_NGTCP2 OFF)
    set(USE_QUICHE OFF)
    set(HTTP_ONLY ON)
    set(CURL_USE_LIBSSH2 OFF)
    set(CURL_USE_LIBSSH OFF)
    set(CURL_USE_GSASL OFF)
    set(CURL_USE_GSSAPI OFF)
    set(CURL_DISABLE_LDAP ON)
    set(CURL_DISABLE_NETRC ON)
    set(CURL_DISABLE_DOH ON)
    set(CURL_DISABLE_ALTSVC ON)
    set(CURL_DISABLE_MIME ON)
    set(CURL_DISABLE_FORM_API ON)
    set(CURL_DISABLE_KERBEROS_AUTH ON)
    set(CURL_DISABLE_NEGOTIATE_AUTH ON)
    set(CURL_ENABLE_NTLM OFF)
    set(CURL_DISABLE_AWS ON)
    set(CURL_DISABLE_OPENSSL_AUTO_LOAD_CONFIG ON)
    set(CURL_ENABLE_SSL ON)
    set(CURL_USE_MBEDTLS OFF)
    set(CURL_USE_WOLFSSL OFF)
    set(CURL_USE_GNUTLS OFF)
    set(CURL_USE_RUSTLS OFF)
    set(CURL_HIDES_SYMBOLS ON)
    set(PICKY_COMPILER OFF)
    set(CURL_USE_SCHANNEL OFF)
    set(CURL_USE_OPENSSL OFF)
    if(WIN32)
        set(tls_default SCHANNEL)
    else()
        set(tls_default OPENSSL)
    endif()
    set(LND_CURL_TLS "${tls_default}" CACHE STRING "Vendored curl TLS backend: SCHANNEL or OPENSSL")
    set_property(CACHE LND_CURL_TLS PROPERTY STRINGS SCHANNEL OPENSSL)
    if(LND_CURL_TLS STREQUAL "SCHANNEL" AND WIN32)
        set(CURL_USE_SCHANNEL ON)
    elseif(LND_CURL_TLS STREQUAL "OPENSSL")
        lnd_vendor_openssl()
        list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/find")
        set(CURL_USE_OPENSSL ON)
        set(HAVE_AWSLC OFF)
        set(HAVE_BORINGSSL OFF)
        set(HAVE_LIBRESSL OFF)
        set(HAVE_SSL_SET0_WBIO ON)
        file(READ "${LND_VENDOR_DIR}/cacert/ca-bundle.crt" roots HEX)
        string(REGEX REPLACE "(..)" "0x\\1," roots "${roots}")
        file(MAKE_DIRECTORY "${LND_GENERATED_DIR}")
        file(WRITE "${LND_GENERATED_DIR}/lnd_http_ca.h" "static const unsigned char lnd_http_ca[] = {${roots}0};\n")
        if(APPLE)
            set(USE_APPLE_SECTRUST ON)
        endif()
    else()
        message(FATAL_ERROR "LND_CURL_TLS must be OPENSSL, or SCHANNEL on Windows")
    endif()
    if(APPLE)
        set(HAVE_PIPE2 0)
    endif()
    set(CARES_STATIC ON)
    set(CARES_SHARED OFF)
    set(CARES_INSTALL OFF)
    set(CARES_BUILD_TESTS OFF)
    set(CARES_BUILD_TOOLS OFF)
    set(CARES_STATIC_PIC ON)
    set(CARES_THREADS OFF)
    add_subdirectory("${LND_VENDOR_DIR}/c-ares" "${CMAKE_BINARY_DIR}/vendor/c-ares" EXCLUDE_FROM_ALL)
    set(CARES_INCLUDE_DIR "${LND_VENDOR_DIR}/c-ares/include")
    set(CARES_LIBRARY c-ares::cares_static)
    set(CARES_USE_STATIC_LIBS ON)
    set(ENABLE_ARES ON)
    set(ENABLE_THREADED_RESOLVER OFF)
    add_library(CURL::cares INTERFACE IMPORTED GLOBAL)
    set_target_properties(CURL::cares PROPERTIES INTERFACE_LINK_LIBRARIES c-ares::cares_static)
    add_subdirectory("${LND_VENDOR_DIR}/curl" "${CMAKE_BINARY_DIR}/vendor/curl" EXCLUDE_FROM_ALL)
    add_library(lnd_curl ALIAS libcurl_static)
    lnd_vendor_quiet(libcurl_static)
    get_target_property(cares_target c-ares::cares_static ALIASED_TARGET)
    lnd_vendor_quiet(${cares_target})
    cmake_policy(POP)
endfunction()
