function(lnd_vendor_bungee)
    if(TARGET lnd_bungee)
        return()
    endif()
    set(dir ${LND_VENDOR_DIR}/bungee)
    foreach(required bungee/Bungee.h submodules/eigen/Eigen/Core submodules/pffft/pffft.c)
        if(NOT EXISTS "${dir}/${required}")
            message(FATAL_ERROR "Bungee vendor is incomplete: ${required}; run ruby tools/vendor.rb bungee")
        endif()
    endforeach()
    include(${CMAKE_CURRENT_SOURCE_DIR}/modules/processing/stretch/bungee/vendor_safety.cmake)
    add_library(lnd_bungee_pffft STATIC ${pffft_source} ${dir}/submodules/pffft/fftpack.c)
    target_include_directories(lnd_bungee_pffft PRIVATE ${dir}/submodules/pffft)
    target_compile_definitions(lnd_bungee_pffft PRIVATE _USE_MATH_DEFINES=1)
    set_target_properties(lnd_bungee_pffft PROPERTIES C_STANDARD 11 POSITION_INDEPENDENT_CODE ON C_VISIBILITY_PRESET hidden)
    add_library(lnd_bungee STATIC ${bungee_sources})
    target_include_directories(lnd_bungee PRIVATE ${dir} ${dir}/src ${dir}/submodules/eigen)
    target_link_libraries(lnd_bungee PUBLIC lnd_bungee_pffft)
    if(ANDROID)
        target_link_libraries(lnd_bungee PUBLIC log)
    endif()
    target_compile_definitions(lnd_bungee PRIVATE BUNGEE_VERSION="2.4.30" BUNGEE_SELF_TEST=0 EIGEN_DONT_PARALLELIZE=1)
    set_target_properties(lnd_bungee PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS OFF POSITION_INDEPENDENT_CODE ON CXX_VISIBILITY_PRESET hidden)
    option(LND_BUNGEE_SIMD "Enable vendor Bungee/Eigen/PFFFT SIMD kernels" ON)
    if(NOT LND_BUNGEE_SIMD)
        target_compile_definitions(lnd_bungee PRIVATE EIGEN_DONT_VECTORIZE=1)
        target_compile_definitions(lnd_bungee_pffft PRIVATE PFFFT_SIMD_DISABLE=1)
    endif()
    if(MSVC)
        target_compile_options(lnd_bungee PRIVATE /EHsc /O2)
        target_compile_options(lnd_bungee_pffft PRIVATE /O2)
    else()
        target_compile_options(lnd_bungee PRIVATE -fexceptions -fwrapv -ffunction-sections -fdata-sections
            $<$<CONFIG:Release>:-O3> -fno-math-errno -fno-trapping-math)
        target_compile_options(lnd_bungee_pffft PRIVATE -ffunction-sections -fdata-sections
            $<$<CONFIG:Release>:-O3> -fno-math-errno -fno-trapping-math)
    endif()
    lnd_vendor_quiet(lnd_bungee)
    lnd_vendor_quiet(lnd_bungee_pffft)
endfunction()
