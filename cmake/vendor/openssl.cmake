function(lnd_vendor_openssl)
    if(TARGET lnd_openssl_crypto)
        return()
    endif()
    if(WIN32 AND NOT MSVC)
        get_filename_component(compiler_dir "${CMAKE_C_COMPILER}" DIRECTORY)
        set(msys_bin "${compiler_dir}/../../usr/bin" C:/msys64/usr/bin)
        find_program(LND_OPENSSL_PERL NAMES perl PATHS ${msys_bin} NO_DEFAULT_PATH)
        find_program(LND_OPENSSL_MAKE NAMES make PATHS ${msys_bin} NO_DEFAULT_PATH)
    endif()
    if(NOT LND_OPENSSL_PERL)
        find_package(Perl REQUIRED)
        set(LND_OPENSSL_PERL "${PERL_EXECUTABLE}" CACHE FILEPATH "Perl used by OpenSSL Configure")
    endif()
    if(MSVC)
        find_program(LND_OPENSSL_MAKE NAMES nmake REQUIRED)
    else()
        find_program(LND_OPENSSL_MAKE NAMES gmake make mingw32-make REQUIRED)
    endif()
    set(LND_OPENSSL_JOBS 4 CACHE STRING "Parallel OpenSSL compilation jobs")
    set(source "${LND_VENDOR_DIR}/openssl")
    set(build "${CMAKE_BINARY_DIR}/vendor/openssl")
    file(MAKE_DIRECTORY "${build}/include")
    string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" arch)
    if(WIN32)
        include(CheckCSourceCompiles)
        set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
        check_c_source_compiles("#if !defined(__aarch64__) && !defined(_M_ARM64)\n#error unsupported\n#endif\nint main(void) { return 0; }" LND_OPENSSL_TARGET_ARM64)
        if(LND_OPENSSL_TARGET_ARM64)
            set(arch arm64)
        endif()
    endif()
    if(ANDROID)
        if(CMAKE_ANDROID_ARCH_ABI STREQUAL "arm64-v8a")
            set(platform android-arm64)
        elseif(CMAKE_ANDROID_ARCH_ABI STREQUAL "armeabi-v7a")
            set(platform android-arm)
        elseif(CMAKE_ANDROID_ARCH_ABI STREQUAL "x86")
            set(platform android-x86)
        elseif(CMAKE_ANDROID_ARCH_ABI STREQUAL "x86_64")
            set(platform android-x86_64)
        endif()
    elseif(WIN32)
        if(MSVC)
            if(arch MATCHES "arm64|aarch64" OR CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64")
                set(platform VC-WIN64-ARM)
            elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
                set(platform VC-WIN64A)
            else()
                set(platform VC-WIN32)
            endif()
        elseif(arch MATCHES "arm64|aarch64")
            set(platform mingwarm64)
        elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
            set(platform mingw64)
        else()
            set(platform mingw)
        endif()
    elseif(APPLE)
        set(apple_arch "${CMAKE_OSX_ARCHITECTURES}")
        if(NOT apple_arch)
            set(apple_arch "${arch}")
        endif()
        list(LENGTH apple_arch arch_count)
        if(arch_count GREATER 1)
            message(FATAL_ERROR "Build OpenSSL/Lindar per Apple architecture, then combine the archives")
        endif()
        if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
            if(CMAKE_OSX_SYSROOT MATCHES "simulator")
                if(apple_arch MATCHES "arm64|aarch64")
                    set(platform iossimulator-arm64-xcrun)
                else()
                    set(platform iossimulator-x86_64-xcrun)
                endif()
            else()
                set(platform ios64-xcrun)
            endif()
        elseif(apple_arch MATCHES "arm64|aarch64")
            set(platform darwin64-arm64)
        else()
            set(platform darwin64-x86_64)
        endif()
    elseif(arch MATCHES "aarch64|arm64")
        set(platform linux-aarch64)
    elseif(arch MATCHES "^arm")
        set(platform linux-armv4)
    elseif(arch MATCHES "x86_64|amd64")
        set(platform linux-x86_64)
    elseif(arch MATCHES "i.86|x86")
        set(platform linux-x86)
    elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(platform linux-generic64)
    else()
        set(platform linux-generic32)
    endif()
    set(LND_OPENSSL_TARGET "${platform}" CACHE STRING "OpenSSL Configure target")
    set(asm_default ON)
    if(WIN32 AND NOT MSVC AND arch MATCHES "arm64|aarch64")
        set(asm_default OFF)
    endif()
    option(LND_OPENSSL_ASM "Enable OpenSSL assembler kernels" ${asm_default})
    set(args "${source}/Configure" "${LND_OPENSSL_TARGET}" no-shared no-module no-tests no-apps no-docs
        "--prefix=${build}/install" "--openssldir=${build}/install/ssl" --libdir=lib)
    if(NOT LND_OPENSSL_ASM)
        list(APPEND args no-asm)
    endif()
    set(flags "${CMAKE_C_FLAGS}")
    if(NOT MSVC)
        string(APPEND flags " -O3")
    endif()
    if(NOT MSVC)
        if(CMAKE_C_COMPILER_TARGET)
            string(APPEND flags " --target=${CMAKE_C_COMPILER_TARGET}")
        endif()
        if(CMAKE_SYSROOT)
            string(APPEND flags " --sysroot=${CMAKE_SYSROOT}")
        endif()
        if(UNIX)
            string(APPEND flags " -fPIC -fvisibility=hidden")
        endif()
        if(APPLE)
            string(APPEND flags " -arch ${apple_arch}")
            if(CMAKE_OSX_SYSROOT)
                set(sdk "${CMAKE_OSX_SYSROOT}")
                if(NOT IS_ABSOLUTE "${sdk}")
                    execute_process(COMMAND xcrun --sdk "${sdk}" --show-sdk-path OUTPUT_VARIABLE sdk OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
                endif()
                string(APPEND flags " -isysroot ${sdk}")
            endif()
            if(CMAKE_OSX_DEPLOYMENT_TARGET)
                if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
                    if(CMAKE_OSX_SYSROOT MATCHES "simulator")
                        string(APPEND flags " -mios-simulator-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
                    else()
                        string(APPEND flags " -mios-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
                    endif()
                else()
                    string(APPEND flags " -mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
                endif()
            endif()
        endif()
    endif()
    list(APPEND args "CC=${CMAKE_C_COMPILER}" "AR=${CMAKE_AR}" "CFLAGS=${flags}")
    if(CMAKE_RANLIB AND NOT MSVC)
        list(APPEND args "RANLIB=${CMAKE_RANLIB}")
    endif()
    set(env "")
    set(tool_path "$ENV{PATH}")
    if(WIN32 AND NOT MSVC)
        get_filename_component(perl_dir "${LND_OPENSSL_PERL}" DIRECTORY)
        get_filename_component(make_dir "${LND_OPENSSL_MAKE}" DIRECTORY)
        set(tool_path "${compiler_dir};${perl_dir};${make_dir};$ENV{PATH}")
    endif()
    if(ANDROID)
        set(ndk "${CMAKE_ANDROID_NDK}")
        get_filename_component(compiler_dir "${CMAKE_C_COMPILER}" DIRECTORY)
        if(CMAKE_HOST_WIN32)
            get_filename_component(perl_dir "${LND_OPENSSL_PERL}" DIRECTORY)
            find_program(LND_OPENSSL_CYGPATH cygpath HINTS "${perl_dir}" NO_DEFAULT_PATH)
            if(LND_OPENSSL_CYGPATH)
                execute_process(COMMAND "${LND_OPENSSL_CYGPATH}" -u "${ndk}" OUTPUT_VARIABLE ndk OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
            endif()
            set(tool_path "${compiler_dir};$ENV{PATH}")
        else()
            set(tool_path "${compiler_dir}:$ENV{PATH}")
        endif()
        list(APPEND env "ANDROID_NDK_ROOT=${ndk}")
        set(api "${CMAKE_SYSTEM_VERSION}")
        if(ANDROID_PLATFORM_LEVEL)
            set(api "${ANDROID_PLATFORM_LEVEL}")
        elseif(ANDROID_NATIVE_API_LEVEL)
            set(api "${ANDROID_NATIVE_API_LEVEL}")
        endif()
        list(APPEND args "CPPFLAGS=-D__ANDROID_API__=${api}")
    endif()
    if(MSVC)
        set(make_flags "")
        set(crypto "${build}/libcrypto.lib")
        set(ssl "${build}/libssl.lib")
    else()
        set(make_flags "-j${LND_OPENSSL_JOBS}")
        set(crypto "${build}/libcrypto.a")
        set(ssl "${build}/libssl.a")
    endif()
    set(configure "${CMAKE_COMMAND}" -E env ${env} "${LND_OPENSSL_PERL}" ${args})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}/VERSION.dat")
    file(SHA256 "${source}/VERSION.dat" version)
    string(SHA256 fingerprint "${version};${configure};${LND_OPENSSL_MAKE}")
    set(previous "")
    if(EXISTS "${build}/lindar-config")
        file(READ "${build}/lindar-config" previous)
    endif()
    if(NOT previous STREQUAL fingerprint)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env "PATH=${tool_path}" ${env} "${LND_OPENSSL_PERL}" ${args} WORKING_DIRECTORY "${build}" RESULT_VARIABLE status
            OUTPUT_FILE "${build}/configure.log" ERROR_FILE "${build}/configure-error.log")
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "OpenSSL Configure failed: see ${build}/configure-error.log")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env "PATH=${tool_path}" ${env} "${LND_OPENSSL_MAKE}" ${make_flags} build_generated WORKING_DIRECTORY "${build}" RESULT_VARIABLE status
            OUTPUT_FILE "${build}/headers.log" ERROR_FILE "${build}/headers-error.log")
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "OpenSSL header generation failed: see ${build}/headers-error.log")
        endif()
        file(WRITE "${build}/lindar-config" "${fingerprint}")
    endif()
    add_custom_command(OUTPUT "${crypto}" "${ssl}"
        COMMAND "${CMAKE_COMMAND}" -E env "PATH=${tool_path}" ${env} "${LND_OPENSSL_PERL}" ${args}
        COMMAND "${CMAKE_COMMAND}" -E env "PATH=${tool_path}" ${env} "${LND_OPENSSL_MAKE}" ${make_flags} build_libs
        WORKING_DIRECTORY "${build}" DEPENDS "${build}/lindar-config"
        USES_TERMINAL VERBATIM)
    add_custom_target(lnd_openssl_build DEPENDS "${crypto}" "${ssl}")
    add_library(lnd_openssl_crypto STATIC IMPORTED GLOBAL)
    add_library(lnd_openssl_ssl STATIC IMPORTED GLOBAL)
    set_target_properties(lnd_openssl_crypto PROPERTIES IMPORTED_LOCATION "${crypto}"
        INTERFACE_INCLUDE_DIRECTORIES "${build}/include;${source}/include")
    set_target_properties(lnd_openssl_ssl PROPERTIES IMPORTED_LOCATION "${ssl}"
        INTERFACE_INCLUDE_DIRECTORIES "${build}/include;${source}/include"
        INTERFACE_LINK_LIBRARIES lnd_openssl_crypto)
    add_dependencies(lnd_openssl_crypto lnd_openssl_build)
    add_dependencies(lnd_openssl_ssl lnd_openssl_build)
    if(WIN32)
        set_property(TARGET lnd_openssl_crypto APPEND PROPERTY INTERFACE_LINK_LIBRARIES ws2_32 crypt32 advapi32 user32 gdi32 bcrypt)
    else()
        find_package(Threads REQUIRED)
        set_property(TARGET lnd_openssl_crypto APPEND PROPERTY INTERFACE_LINK_LIBRARIES Threads::Threads ${CMAKE_DL_LIBS})
    endif()
    set(LND_OPENSSL_BUILD "${build}" CACHE INTERNAL "")
endfunction()
